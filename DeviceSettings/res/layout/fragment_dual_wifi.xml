<?xml version="1.0" encoding="utf-8"?>
<!-- Dual Wi-Fi page (DualWifiFragment), styled like fragment_network_bands.xml. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg_color"
    android:clipToPadding="false"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp">

        <!-- MAIN SWITCH -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:padding="16dp"
            android:background="@drawable/card_bg_dark">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@+id/dual_switch"
                android:orientation="vertical"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dual_wifi_use"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary_color" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/dual_wifi_summary"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary_color" />
            </LinearLayout>

            <Switch
                android:id="@+id/dual_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:thumb="@drawable/m3_switch_thumb_drawable"
                android:track="@drawable/m3_switch_track_drawable" />
        </RelativeLayout>

        <!-- 1. CONNECTIONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp"
            android:padding="16dp"
            android:background="@drawable/card_bg_dark">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/chip_active_band"
                    android:gravity="center"
                    android:text="1"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary_color" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/dual_wifi_connections"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary_color" />
            </LinearLayout>

            <!-- Main row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="@drawable/chip_active_band">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dual_wifi_main"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary_color" />

                    <TextView
                        android:id="@+id/main_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary_color" />

                    <TextView
                        android:id="@+id/main_detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary_color" />
                </LinearLayout>

                <TextView
                    android:id="@+id/main_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp" />
            </LinearLayout>

            <!-- Backup row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="@drawable/chip_active_band">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dual_wifi_backup"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary_color" />

                    <TextView
                        android:id="@+id/backup_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary_color" />

                    <TextView
                        android:id="@+id/backup_detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary_color" />
                </LinearLayout>

                <TextView
                    android:id="@+id/backup_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 2. BACKUP NETWORK -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp"
            android:padding="16dp"
            android:background="@drawable/card_bg_dark">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/chip_active_band"
                    android:gravity="center"
                    android:text="2"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary_color" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/dual_wifi_backup_network"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary_color" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/dual_wifi_backup_hint"
                android:textSize="10sp"
                android:textColor="@color/text_secondary_color" />

            <RadioGroup
                android:id="@+id/backup_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- 3. OPTIONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp"
            android:padding="16dp"
            android:background="@drawable/card_bg_dark">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/chip_active_band"
                    android:gravity="center"
                    android:text="3"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary_color" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/dual_wifi_options"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary_color" />
            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@+id/fast_switch"
                    android:orientation="vertical"
                    android:paddingEnd="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dual_wifi_fast_title"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary_color" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/dual_wifi_fast_summary"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary_color" />
                </LinearLayout>

                <Switch
                    android:id="@+id/fast_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:thumb="@drawable/m3_switch_thumb_drawable"
                    android:track="@drawable/m3_switch_track_drawable" />
            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="@color/card_stroke_color" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@+id/save_switch"
                    android:orientation="vertical"
                    android:paddingEnd="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dual_wifi_save_title"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary_color" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/dual_wifi_save_summary"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary_color" />
                </LinearLayout>

                <Switch
                    android:id="@+id/save_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:thumb="@drawable/m3_switch_thumb_drawable"
                    android:track="@drawable/m3_switch_track_drawable" />
            </RelativeLayout>
        </LinearLayout>

        <!-- 4. RECENT ACTIVITY -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/card_bg_dark">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/chip_active_band"
                    android:gravity="center"
                    android:text="4"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary_color" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/dual_wifi_activity"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary_color" />
            </LinearLayout>

            <TextView
                android:id="@+id/activity_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:textSize="11sp"
                android:textColor="@color/text_secondary_color" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
