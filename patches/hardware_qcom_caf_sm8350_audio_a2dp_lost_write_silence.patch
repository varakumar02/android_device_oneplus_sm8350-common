--- a/hal/audio_hw.c
+++ b/hal/audio_hw.c
@@ -5331,6 +5331,7 @@ int route_output_stream(struct stream_out *out,
     struct listnode new_devices;
     bool bypass_a2dp = false;
     bool reconfig = false;
+    bool a2dp_lost = false;
     unsigned long service_interval = 0;
 
     ALOGD("%s: enter: usecase(%d: %s) devices %x",
@@ -5368,7 +5369,14 @@ int route_output_stream(struct stream_out *out,
             !audio_extn_a2dp_source_is_ready() &&
