+         * again rather than play it on the speaker.
+         */
+        a2dp_lost = !is_offload_usecase(out->usecase);
     }
+    out->a2dp_lost_muted = a2dp_lost;
     /*
      * When USB headset is disconnected the music playback paused
      * and the policy manager send routing=0. But if the USB is connected
@@ -6631,7 +6639,7 @@ static ssize_t out_write(struct audio_stream_out *stream, const void *buffer,
     } else {
         if (out->pcm) {
             size_t bytes_to_write = bytes;
-            if (out->muted)
+            if (out->muted || out->a2dp_lost_muted)
                 memset((void *)buffer, 0, bytes);
             ALOGV("%s: frames=%zu, frame_size=%zu, bytes_to_write=%zu",
                      __func__, frames, frame_size, bytes_to_write);
