+    /**
+     * Removes tracking parameters from links in the clip's text, html text and http(s) uri,
+     * unless the user turned it off. Items without a tracked link are left untouched.
+     */
+    private ClipData stripLinkTracking(ClipData clip, @UserIdInt int userId) {
+        final long callingId = Binder.clearCallingIdentity();
+        try {
+            if (Settings.Secure.getIntForUser(getContext().getContentResolver(),
+                    LinkTrackingStripper.SETTING, 1, userId) == 0) {
+                return clip;
+            }
+        } finally {
+            Binder.restoreCallingIdentity(callingId);
+        }
+        for (int i = 0; i < clip.getItemCount(); i++) {
+            final ClipData.Item item = clip.getItemAt(i);
+            if (item.getIntentSender() != null) continue;
+            final CharSequence text = item.getText();
+            final String html = item.getHtmlText();
+            final Uri uri = item.getUri();
+            final String newText = text == null ? null
+                    : LinkTrackingStripper.strip(text.toString());
+            final String newHtml = LinkTrackingStripper.strip(html);
+            Uri newUri = uri;
+            if (uri != null && ("http".equals(uri.getScheme()) || "https".equals(uri.getScheme()))) {
+                final String s = uri.toString();
+                final String clean = LinkTrackingStripper.stripUrl(s);
+                if (clean != s) newUri = Uri.parse(clean);
+            }
+            final boolean textChanged = text != null && !newText.contentEquals(text);
+            if (!textChanged && newHtml == html && newUri == uri) continue;
+            clip.setItemAt(i, new ClipData.Item.Builder()
+                    .setText(textChanged ? newText : text)
+                    .setHtmlText(newHtml)
+                    .setIntent(item.getIntent())
+                    .setUri(newUri)
+                    .build());
+        }
+        return clip;
+    }
+
