From 649ba2f918051e565497c583bb1d3d592e98eaa3 Mon Sep 17 00:00:00 2001
From: AxionOS <noreply@axionos>
Date: Mon, 26 Oct 2026 00:42:48 +0530
Subject: [PATCH] Settings: make the refresh rate list a fixed rate

The list under Display (config_show_peak_refresh_rate_switch) offered a
peak rate only, with an "Infinity" entry for the highest mode. It now
lists every mode's rate once, as a number, and writes the chosen value to
both PEAK_REFRESH_RATE and MIN_REFRESH_RATE, so 60 means 60 Hz and 120
means 120 Hz. The current entry is read from MIN_REFRESH_RATE, falling back
to the peak setting when no rate has been picked. Title: Screen refresh rate.
---
 res/values/cm_strings.xml                     |  3 +++
 res/xml/display_settings.xml                  |  2 +-
 ...akRefreshRateListPreferenceController.java | 23 +++++++++++++------
 3 files changed, 20 insertions(+), 8 deletions(-)

diff --git a/res/values/cm_strings.xml b/res/values/cm_strings.xml
index 18e5b76..6feb1e6 100644
--- a/res/values/cm_strings.xml
+++ b/res/values/cm_strings.xml
@@ -87,6 +87,9 @@
     <!-- Max refresh rate -->
     <string name="max_refresh_rate_title">Peak refresh rate</string>
 
+    <!-- Fixed refresh rate list (sets min and peak to the same rate) -->
+    <string name="screen_refresh_rate_title">Screen refresh rate</string>
+
     <!-- Min refresh rate -->
     <string name="min_refresh_rate_title">Minimum refresh rate</string>
 
diff --git a/res/xml/display_settings.xml b/res/xml/display_settings.xml
index c3b05ae..16eb5a3 100644
--- a/res/xml/display_settings.xml
+++ b/res/xml/display_settings.xml
@@ -230,7 +230,7 @@
 
         <ListPreference
             android:key="max_refresh_rate"
-            android:title="@string/max_refresh_rate_title"
+            android:title="@string/screen_refresh_rate_title"
             android:summary="@string/summary_placeholder"
             settings:controller="com.android.settings.display.PeakRefreshRateListPreferenceController" />
 
diff --git a/src/com/android/settings/display/PeakRefreshRateListPreferenceController.java b/src/com/android/settings/display/PeakRefreshRateListPreferenceController.java
index 9acf6c1..63328bc 100644
--- a/src/com/android/settings/display/PeakRefreshRateListPreferenceController.java
+++ b/src/com/android/settings/display/PeakRefreshRateListPreferenceController.java
@@ -83,13 +83,14 @@ public class PeakRefreshRateListPreferenceController extends BasePreferenceContr
             Arrays.sort(modes, (mode1, mode2) ->
                 Float.compare(mode2.getRefreshRate(), mode1.getRefreshRate()));
             for (Display.Mode m : modes) {
+                final String value = String.format(Locale.US, "%.02f", m.getRefreshRate());
+                // Panels can list the same rate in more than one timing; show it once.
                 if (m.getPhysicalWidth() == mode.getPhysicalWidth() &&
-                        m.getPhysicalHeight() == mode.getPhysicalHeight()) {
+                        m.getPhysicalHeight() == mode.getPhysicalHeight() &&
+                        !mValues.contains(value)) {
                     mEntries.add(String.format("%.02fHz", m.getRefreshRate())
                             .replaceAll("[\\.,]00", ""));
-                    mValues.add(mValues.isEmpty()
-                            ? "Infinity"
-                            : String.format(Locale.US, "%.02f", m.getRefreshRate()));
+                    mValues.add(value);
                 }
             }
         }
@@ -115,8 +116,13 @@ public class PeakRefreshRateListPreferenceController extends BasePreferenceContr
 
     @Override
     public void updateState(Preference preference) {
-        final float currentValue = Settings.System.getFloat(mContext.getContentResolver(),
-                Settings.System.PEAK_REFRESH_RATE, getDefaultPeakRefreshRate());
+        // The list sets a fixed rate: min and peak hold the same value once a rate is picked.
+        float currentValue = Settings.System.getFloat(mContext.getContentResolver(),
+                Settings.System.MIN_REFRESH_RATE, 0f);
+        if (currentValue <= 0f) {
+            currentValue = Settings.System.getFloat(mContext.getContentResolver(),
+                    Settings.System.PEAK_REFRESH_RATE, getDefaultPeakRefreshRate());
+        }
         int index = mListPreference.findIndexOfValue(
                 String.format(Locale.US, "%.02f", currentValue));
         if (index < 0) index = 0;
@@ -126,8 +132,11 @@ public class PeakRefreshRateListPreferenceController extends BasePreferenceContr
 
     @Override
     public boolean onPreferenceChange(Preference preference, Object newValue) {
+        final float refreshRate = Float.valueOf((String) newValue);
         Settings.System.putFloat(mContext.getContentResolver(), Settings.System.PEAK_REFRESH_RATE,
-                Float.valueOf((String) newValue));
+                refreshRate);
+        Settings.System.putFloat(mContext.getContentResolver(), Settings.System.MIN_REFRESH_RATE,
+                refreshRate);
         updateState(preference);
         return true;
     }
-- 
2.56.0

