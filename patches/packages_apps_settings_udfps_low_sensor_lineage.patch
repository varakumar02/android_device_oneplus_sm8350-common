From ff6c7f45b4e02a76affb6df85dd9ed3e8252b40c Mon Sep 17 00:00:00 2001
From: Omkar Chandorkar <gotenksIN@aospa.co>
Date: Sun, 30 Aug 2026 14:22:23 +0530
Subject: [PATCH] Settings: Disable UDFPS enroll clipping on low sensors

Keep the Glif Expressive footer transparent and disable clipping
on low-positioned portrait UDFPS sensors.

Change-Id: Ie0132e6195883ecc3c3fcfb042058348997e7008
Signed-off-by: Omkar Chandorkar <gotenksIN@aospa.co>
Signed-off-by: Saalim Quadri <danascape@gmail.com>
(cherry picked from commit b6d602b3ea6a79d6a164711c1abb95ba736320cc)
[varakumar02: Android 16 setupdesign has no getFooterBarMoreToScrollBackgroundColor();
 override getFooterBackgroundColorFromStyle() instead. The low-sensor check reuses
 the existing LOW_UDFPS_THRESHOLD test from adjustFooterButtonForLowUdfps() instead of
 BiometricUtils.isUdfpsLocationLow(), and the FingerprintEnrollEnrolling hunk is dropped
 because the start-aligned skip button is already there]
Signed-off-by: varakumar02 <tony_1@riseup.net>
---
 .../udfps_enroll_enrolling_non_scroll.xml     |  2 ++
 .../fingerprint/UdfpsEnrollEnrollingView.java | 27 ++++++++++++++-----
 2 files changed, 23 insertions(+), 6 deletions(-)

diff --git a/res/layout/udfps_enroll_enrolling_non_scroll.xml b/res/layout/udfps_enroll_enrolling_non_scroll.xml
index deb9091..e7f8653 100644
--- a/res/layout/udfps_enroll_enrolling_non_scroll.xml
+++ b/res/layout/udfps_enroll_enrolling_non_scroll.xml
@@ -36,6 +36,8 @@
             android:layout_width="match_parent"
             android:layout_height="0dp"
             android:layout_weight="1"
+            android:clipChildren="false"
+            android:clipToPadding="false"
             android:gravity="center|bottom"
             android:orientation="vertical">
 
diff --git a/src/com/android/settings/biometrics/fingerprint/UdfpsEnrollEnrollingView.java b/src/com/android/settings/biometrics/fingerprint/UdfpsEnrollEnrollingView.java
index d9f6ba5..c59ced9 100644
--- a/src/com/android/settings/biometrics/fingerprint/UdfpsEnrollEnrollingView.java
+++ b/src/com/android/settings/biometrics/fingerprint/UdfpsEnrollEnrollingView.java
@@ -21,6 +21,7 @@ import android.animation.ObjectAnimator;
 import android.content.Context;
 import android.content.res.Configuration;
 import android.content.res.TypedArray;
+import android.graphics.Color;
 import android.graphics.Insets;
 import android.graphics.Point;
 import android.graphics.Rect;
@@ -284,6 +285,16 @@ public class UdfpsEnrollEnrollingView extends GlifLayout {
         setOnHoverListener();
     }
 
+    @Override
+    public int getFooterBackgroundColor() {
+        return isUdfpsLocationLow() ? Color.TRANSPARENT : super.getFooterBackgroundColor();
+    }
+
+    @Override
+    public int getFooterBackgroundColorFromStyle() {
+        return isUdfpsLocationLow() ? Color.TRANSPARENT : super.getFooterBackgroundColorFromStyle();
+    }
+
     void setSecondaryButtonBackground(@ColorInt int color) {
         // Set the button background only when the button is not under udfps overlay to avoid UI
         // overlap.
@@ -305,15 +316,19 @@ public class UdfpsEnrollEnrollingView extends GlifLayout {
         });
     }
 
-    void adjustFooterButtonForLowUdfps() {
+    /** Whether the sensor sits low enough in portrait for the footer bar to overlap it. */
+    private boolean isUdfpsLocationLow() {
         if (mIsLandscape || mUdfpsEnrollView == null) {
-            return;
+            return false;
         }
-
         final UdfpsOverlayParams params = mUdfpsEnrollView.getOverlayParams();
-        if (params == null || params.getNaturalDisplayHeight() <= 0
-                || params.getSensorBounds().bottom
-                        <= params.getNaturalDisplayHeight() * LOW_UDFPS_THRESHOLD) {
+        return params != null && params.getNaturalDisplayHeight() > 0
+                && params.getSensorBounds().bottom
+                        > params.getNaturalDisplayHeight() * LOW_UDFPS_THRESHOLD;
+    }
+
+    void adjustFooterButtonForLowUdfps() {
+        if (!isUdfpsLocationLow()) {
             return;
         }
 
-- 
2.56.1

