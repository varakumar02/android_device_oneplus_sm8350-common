From c95cf590ce8217b5c42e937fff92cddec4656e62 Mon Sep 17 00:00:00 2001
From: varakumar02 <tony_1@riseup.net>
Date: Sun, 22 Nov 2026 02:45:07 +0530
Subject: [PATCH] Settings: Show the full UDFPS enroll ring in setup wizard

On devices with a low UDFPS sensor the enroll progress ring is drawn
around the sensor, below the template's content ScrollView
(sud_scroll_view ends where the footer bar starts), inside the area of
the footer bar. From Settings the whole ring shows; during setup only
its top arc above the footer is visible. Two things differ in setup:

- The enrolling screen gets a setup wizard theme (GlifV*Theme from
  SetupWizardUtils.getTheme()), which keeps setupdesign's default
  sudClipChildren/sudClipToPadding of true, so the template clips the
  ring at the bottom of sud_scroll_view.
- With GlifExpressive, GlifLayout.updateBackgroundColor() repaints the
  footer bar and the navigation bar on every scroll of its scroll views
  and once shortly after the layout is shown. During setup it paints
  the partner footer color (CONFIG_FOOTER_BAR_BG_COLOR), outside setup
  it paints transparent, so in setup the footer covers the ring even
  though FingerprintEnrollEnrolling sets the button container
  transparent in onCreate().

In portrait, turn clipping off on every container between the ring and
the enrolling layout, and override onScrolling() to put the footer bar
and navigation bar back to transparent after GlifLayout repaints them.

Tested on OnePlus 9 (lemonade, sensor at y=2206 of 2400): the ring view
spans y=2065-2459, sud_scroll_view ends and the footer starts at
y=2040, and the ring was cut there during setup.

Signed-off-by: varakumar02 <tony_1@riseup.net>
---
 .../fingerprint/UdfpsEnrollEnrollingView.java | 48 +++++++++++++++++++
 1 file changed, 48 insertions(+)

diff --git a/src/com/android/settings/biometrics/fingerprint/UdfpsEnrollEnrollingView.java b/src/com/android/settings/biometrics/fingerprint/UdfpsEnrollEnrollingView.java
index d9f6ba5..8b2ce22 100644
--- a/src/com/android/settings/biometrics/fingerprint/UdfpsEnrollEnrollingView.java
+++ b/src/com/android/settings/biometrics/fingerprint/UdfpsEnrollEnrollingView.java
@@ -21,6 +21,7 @@ import android.animation.ObjectAnimator;
 import android.content.Context;
 import android.content.res.Configuration;
 import android.content.res.TypedArray;
+import android.graphics.Color;
 import android.graphics.Insets;
 import android.graphics.Point;
 import android.graphics.Rect;
@@ -37,6 +38,7 @@ import android.view.LayoutInflater;
 import android.view.Surface;
 import android.view.View;
 import android.view.ViewGroup;
+import android.view.ViewParent;
 import android.view.WindowInsets;
 import android.view.WindowManager;
 import android.view.accessibility.AccessibilityManager;
@@ -58,6 +60,7 @@ import com.android.systemui.biometrics.UdfpsUtils;
 import com.android.systemui.biometrics.shared.model.UdfpsOverlayParams;
 
 import com.google.android.setupcompat.template.FooterBarMixin;
+import com.google.android.setupcompat.template.SystemNavBarMixin;
 import com.google.android.setupdesign.GlifLayout;
 import com.google.android.setupdesign.view.BottomScrollView;
 
@@ -277,6 +280,7 @@ public class UdfpsEnrollEnrollingView extends GlifLayout {
 
         if (!mIsLandscape) {
             adjustPortraitPaddings();
+            disableClippingToRoot(mUdfpsEnrollView);
         } else if (mShouldUseReverseLandscape) {
             swapHeaderAndContent();
         }
@@ -361,6 +365,50 @@ public class UdfpsEnrollEnrollingView extends GlifLayout {
         mUdfpsEnrollView.setEnrollHelper(udfpsEnrollHelper);
     }
 
+    /**
+     * The enroll progress ring is drawn around the UDFPS sensor, which on low sensors sits
+     * below the bottom of the template's content ScrollView (sud_scroll_view ends where the
+     * footer bar starts). Setup wizard themes (GlifV*Theme) keep setupdesign's default
+     * sudClipChildren/sudClipToPadding of true, so the ring is cut at that edge during setup,
+     * while the Settings theme lets it draw past it. Turn clipping off on every container
+     * between the ring and this layout so it draws fully whatever the theme.
+     */
+    private void disableClippingToRoot(View view) {
+        ViewParent parent = view.getParent();
+        while (parent instanceof ViewGroup) {
+            final ViewGroup group = (ViewGroup) parent;
+            group.setClipChildren(false);
+            group.setClipToPadding(false);
+            if (group == this) {
+                break;
+            }
+            parent = group.getParent();
+        }
+    }
+
+    /**
+     * In portrait the progress ring sits behind the footer bar. With GlifExpressive,
+     * GlifLayout repaints the footer and navigation bar in updateBackgroundColor() whenever
+     * its scroll views report a scroll (and once shortly after the layout is shown): with
+     * the partner footer color during setup, transparent elsewhere. During setup that covers
+     * the ring, so keep both transparent here as they are outside setup.
+     */
+    @Override
+    protected void onScrolling(boolean isBottom) {
+        super.onScrolling(isBottom);
+        if (mIsLandscape) {
+            return;
+        }
+        final FooterBarMixin footerBarMixin = getMixin(FooterBarMixin.class);
+        if (footerBarMixin != null && footerBarMixin.getButtonContainer() != null) {
+            footerBarMixin.getButtonContainer().setBackgroundColor(Color.TRANSPARENT);
+        }
+        final SystemNavBarMixin systemNavBarMixin = getMixin(SystemNavBarMixin.class);
+        if (systemNavBarMixin != null) {
+            systemNavBarMixin.setSystemNavBarBackground(Color.TRANSPARENT);
+        }
+    }
+
     private void adjustPortraitPaddings() {
         // In the portrait mode, layout_container's height is 0, so it's
         // always shown at the bottom of the screen.
