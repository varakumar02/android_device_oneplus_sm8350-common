From 8627d1aa48a9064a754aab15c3a31497368f3a71 Mon Sep 17 00:00:00 2001
From: SagarMakhar <makharsagar@gmail.com>
Date: Tue, 3 Nov 2026 19:38:07 +0000
Subject: [PATCH] Fix navbar showing when QS is expanded and collapsed

Issue: OS-294

Change-Id: Ie9c4a8c4ba92facdd6ac6094ddccc9e5f8b1d801
(cherry picked from commit 408e9bed7db02805bc9cbb444373ebd4cf0fdc5a)
Signed-off-by: varakumar02 <tony_1@riseup.net>
---
 .../fingerprint/FingerprintEnrollEnrolling.java       | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/src/com/android/settings/biometrics/fingerprint/FingerprintEnrollEnrolling.java b/src/com/android/settings/biometrics/fingerprint/FingerprintEnrollEnrolling.java
index 97f3b09..2d32aa3 100644
--- a/src/com/android/settings/biometrics/fingerprint/FingerprintEnrollEnrolling.java
+++ b/src/com/android/settings/biometrics/fingerprint/FingerprintEnrollEnrolling.java
@@ -353,11 +353,17 @@ public class FingerprintEnrollEnrolling extends BiometricsEnrollEnrolling {
         if (!mCanAssumeUdfps) {
             return;
         }
+        hideNavigationBar();
+    }
+
+    private void hideNavigationBar() {
         View decorView = getWindow().getDecorView();
         int uiOptions = decorView.getSystemUiVisibility();
         // Hide the navigation bar and make the layout stable.
         // so that the content doesn't resize as the navigation bar hides and shows.
-        uiOptions |= View.SYSTEM_UI_FLAG_HIDE_NAVIGATION | View.SYSTEM_UI_FLAG_LAYOUT_STABLE;
+        uiOptions |= View.SYSTEM_UI_FLAG_HIDE_NAVIGATION
+                | View.SYSTEM_UI_FLAG_LAYOUT_STABLE
+                | View.SYSTEM_UI_FLAG_IMMERSIVE_STICKY;
         decorView.setSystemUiVisibility(uiOptions);
     }
 
@@ -1238,6 +1244,9 @@ public class FingerprintEnrollEnrolling extends BiometricsEnrollEnrolling {
     @Override
     public void onWindowFocusChanged(boolean hasWindowFocus) {
         super.onWindowFocusChanged(hasWindowFocus);
+        if (hasWindowFocus && mCanAssumeUdfps) {
+            hideNavigationBar();
+        }
     }
 
     public static class IconTouchDialog extends InstrumentedDialogFragment {
-- 
2.56.1

